# Optional overrides for the integration test suite (`npm run test:e2e -w server`).
#
# You do NOT need this file — `server/test/setup/config.ts` carries these exact
# values as defaults, so the suite runs on a fresh clone. Copy it to
# `server/.env.test` (gitignored) only if you want to point the tests at a
# different database, Redis, or port.
#
# Bring the services up first:
#   bash server/test/scripts/start-test-services.sh

DATABASE_URL=postgresql://garden_test:garden_test@127.0.0.1:5432/garden_test

# Deliberately 'development': auth.ts only disables the origin/CSRF checks in
# development, and supertest sends no Origin header, so sign-up and sign-in
# would otherwise be rejected.
NODE_ENV=development

APP_NAME="SEED GARDEN Terminal Test"
AUTH_SECRET=integration-test-secret-not-for-production-use-only
AUTH_BASE_URL=http://localhost:5176
CLIENT_URL=http://localhost:5173
COOKIE_MAXAGE=604800

REDIS_HOST=127.0.0.1
LOG_LEVEL=error
